{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@spartan-ng/helm/button": ["./src/app/shared/ui/button/src/index.ts"],
      "@spartan-ng/helm/utils": ["./src/app/shared/ui/utils/src/index.ts"],
      "@spartan-ng/helm/accordion": ["./src/app/shared/ui/accordion/src/index.ts"],
      "@spartan-ng/helm/alert": ["./src/app/shared/ui/alert/src/index.ts"],
      "@spartan-ng/helm/alert-dialog": ["./src/app/shared/ui/alert-dialog/src/index.ts"],
      "@spartan-ng/helm/aspect-ratio": ["./src/app/shared/ui/aspect-ratio/src/index.ts"],
      "@spartan-ng/helm/avatar": ["./src/app/shared/ui/avatar/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
